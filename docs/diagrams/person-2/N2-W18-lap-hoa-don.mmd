flowchart TD
    start([Bắt đầu]) --> choose[Chọn đơn đủ điều kiện]
    choose --> exists{Đã có hóa đơn?}
    exists -->|Có| existing[Hiển thị hóa đơn hiện có]
    existing --> finish([Kết thúc])
    exists -->|Không| preview[Xem trước dữ liệu hóa đơn]
    preview --> confirm{Xác nhận phát hành?}
    confirm -->|Không| finish
    confirm -->|Có| recheck[Backend chốt lại đơn và tổng tiền]
    recheck --> valid{Dữ liệu còn hợp lệ?}
    valid -->|Không| error[Rollback và thông báo lý do]
    error --> finish
    valid -->|Có| create[Lưu hóa đơn duy nhất theo đơn]
    create --> saved{Transaction thành công?}
    saved -->|Không| error
    saved -->|Có| note[Hiển thị hóa đơn đã lập]
    note --> finish
