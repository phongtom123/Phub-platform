flowchart TD
    start([Bắt đầu]) --> choose[Chọn chương trình]
    choose --> load[Đọc dữ liệu hiện tại]
    load --> editable{Được phép sửa?}
    editable -->|Không| error[Thông báo trạng thái không cho phép]
    error --> finish([Kết thúc])
    editable -->|Có| input[/Sửa thông tin và thời gian/]
    input --> valid{Dữ liệu hợp lệ?}
    valid -->|Không| invalid[Hiển thị lỗi nhập liệu]
    invalid --> input
    valid -->|Có| save[Lưu thay đổi]
    save --> saved{Lưu thành công?}
    saved -->|Không| error
    saved -->|Có| show[Hiển thị dữ liệu đã lưu]
    show --> finish
