flowchart TD
    start([Bắt đầu]) --> choose[Chọn đơn đã xuất kho]
    choose --> complete[Chọn hoàn thành đơn]
    complete --> confirm{Xác nhận hoàn thành?}
    confirm -->|Không| finish([Kết thúc])
    confirm -->|Có| state{Trạng thái hợp lệ?}
    state -->|Không| error[Thông báo xung đột trạng thái]
    error --> finish
    state -->|Có| finance{Đủ điều kiện tài chính và giao hàng?}
    finance -->|Không| unpaid[Thông báo chưa đủ điều kiện]
    unpaid --> finish
    finance -->|Có| update[Chuyển sang Hoàn thành]
    update --> saved{Lưu thành công?}
    saved -->|Không| error
    saved -->|Có| note[Thông báo hoàn thành đơn]
    note --> finish
