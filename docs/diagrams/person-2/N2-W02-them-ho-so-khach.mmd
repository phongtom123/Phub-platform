flowchart TD
    start([Bắt đầu]) --> open[Mở form thêm khách hàng]
    open --> input[/Nhập thông tin hồ sơ/]
    input --> submit[Chọn lưu]
    submit --> valid{Dữ liệu hợp lệ?}
    valid -->|Không| error[Hiển thị lỗi từng trường]
    error --> input
    valid -->|Có| confirm{Xác nhận tạo?}
    confirm -->|Không| finish([Kết thúc])
    confirm -->|Có| create[Tạo hồ sơ khách hàng]
    create --> saved{Lưu thành công?}
    saved -->|Không| fail[Thông báo lý do]
    fail --> finish
    saved -->|Có| note[Thông báo đã tạo hồ sơ]
    note --> finish
