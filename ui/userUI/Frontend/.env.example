# FastAPI address used by the Next.js server only. No Supabase key is needed.
PHUB_API_BASE_URL=http://127.0.0.1:8001
# Optional canonical public UI origin for POST checks behind a reverse proxy.
# Required on Render: the exact public https://...onrender.com UI origin.
# PHUB_UI_ORIGIN=https://your-shop.onrender.com
