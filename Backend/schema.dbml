// ======================================
// 1. KHO - NHAN VIEN
// ======================================

Table KHO {
  ma_kho int [pk, increment]
  ten_kho varchar [not null]
  dia_chi varchar [not null]
  trang_thai int [not null, default: 1]
}

Table NHAN_VIEN {
  ma_nhan_vien varchar [pk]
  ma_kho int [note: 'Kho lam viec chinh; NULL neu la ADMIN hoac chua phan cong']

  loai_nhan_vien varchar [not null, note: 'ADMIN, NHAN_VIEN']

  ho_ten varchar [not null]
  cccd varchar [unique]
  email varchar
  sdt varchar
  luong decimal(18,2)
  trang_thai int [not null, default: 1]

  checks {
    `loai_nhan_vien IN ('ADMIN', 'NHAN_VIEN')`
    `(loai_nhan_vien = 'ADMIN' AND ma_kho IS NULL) OR (loai_nhan_vien = 'NHAN_VIEN' AND ma_kho IS NOT NULL)`
  }
}

Table TAI_KHOAN {
  ma_tk varchar [pk]
  ten_tai_khoan varchar [not null, unique]
  email varchar [unique]
  mat_khau varchar [not null]
  phien_ban_mat_khau uuid [not null, default: `gen_random_uuid()`]
  luu_tru_luc timestamptz [note: 'Xoa mem tai khoan; khoi phuc van giu trang thai an']
  luu_tru_boi varchar [note: 'Tai khoan ADMIN thuc hien xoa mem']
  ma_media_anh_dai_dien uuid [note: 'Anh dai dien; NULL voi tai khoan cu hoac chua tai anh']

  ma_kh varchar [unique]
  ma_nhan_vien varchar [unique]

  trang_thai int [not null, default: 1]

  indexes {
    (ma_media_anh_dai_dien) [note: 'Partial index khi khac NULL trong migration SQL']
  }

  checks {
    `(ma_kh IS NOT NULL AND ma_nhan_vien IS NULL) OR (ma_kh IS NULL AND ma_nhan_vien IS NOT NULL)`
  }
}

// ======================================
// 2. KHACH HANG - TAI KHOAN
// ======================================

Table KHACH_HANG {
  ma_kh varchar [pk]
  ten_kh varchar [not null]
  sdt varchar
  dia_chi_chi_tiet_md varchar
  tinh_thanh_md varchar
  xa_phuong_md varchar
  ngay_sinh date [note: 'CRM; NULL neu chua cung cap']
  ngay_tao timestamptz [note: 'NULL voi ho so cu khong biet ngay tao that']
  cap_nhat_luc timestamptz
  luu_tru_luc timestamptz [note: 'Xoa mem qua RPC: an tai khoan, vo hieu phien cu; khoi phuc khong tu mo tai khoan']
}

Table PHAN_HOI {
  ma_phan_hoi uuid [pk, note: 'gen_random_uuid()']
  ma_kh varchar [not null]
  tieu_de varchar(200) [not null]
  noi_dung text [not null, note: 'Toi da 10000 ky tu']
  ma_sp varchar
  ma_donhang varchar
  trang_thai varchar [not null, default: 'MOI', note: 'MOI, DANG_XU_LY, DA_GIAI_QUYET, DA_DONG']
  muc_do_uu_tien varchar [not null, default: 'BINH_THUONG', note: 'THAP, BINH_THUONG, CAO, KHAN_CAP']
  nguoi_xu_ly varchar
  phan_hoi_quan_ly text
  ngay_phan_hoi timestamptz
  ngay_tao timestamptz [not null]
  cap_nhat_luc timestamptz [not null]
  indexes {
    (trang_thai, ngay_tao)
    (ma_kh, ngay_tao)
  }
}
Ref: PHAN_HOI.ma_kh > KHACH_HANG.ma_kh
Ref: PHAN_HOI.ma_sp > SAN_PHAM.ma_sp
Ref: PHAN_HOI.ma_donhang > DON_HANG.ma_donhang
Ref: PHAN_HOI.nguoi_xu_ly > NHAN_VIEN.ma_nhan_vien

// ======================================
// 3. LOAI SAN PHAM - SAN PHAM - TON KHO
// ======================================

Table LOAI_SP {
  ma_loai_sp varchar [pk]
  ten_loai_sp varchar [not null, unique]
  trang_thai int [not null, default: 1]
}

Table LOAI_SP_CON {
  ma_loai_sp_con varchar [pk]
  ten_loai_sp_con varchar [not null]
  ma_loai_sp varchar [not null]
  trang_thai int [not null, default: 1]

  indexes {
    (ma_loai_sp, ten_loai_sp_con) [unique]
    (ma_loai_sp, ma_loai_sp_con) [unique]
  }
}

Table SAN_PHAM {
  ma_sp varchar [pk]
  sku varchar [not null, unique, note: 'Ma SKU nghiep vu dung de tham chieu san pham']
  ten_sp varchar [not null]
  ma_loai_sp varchar [not null]
  ma_loai_sp_con varchar [not null]
  thuong_hieu varchar
  gia_ban_hien_tai decimal(18,2) [not null]
  mo_ta text
  thong_so_ky_thuat text
  don_vi varchar [not null, default: 'Cai']
  bao_hanh_thang int [not null, default: 0]
  duong_dan_anh varchar [note: 'Anh cu de tuong thich; gallery moi lay tu MEDIA.ma_sp']
  trang_thai int [not null, default: 1]

  checks {
    `gia_ban_hien_tai >= 0`
    `bao_hanh_thang >= 0`
  }
}

Table MEDIA {
  ma_media uuid [pk, default: `gen_random_uuid()`]
  ma_sp varchar [note: 'NULL neu la avatar hoac media chua gan; moi san pham co the co nhieu media']
  thu_tu int [check: `thu_tu >= 0`, note: 'Bat buoc khi ma_sp khac NULL']
  la_anh_chinh boolean [not null, default: false]
  storage_bucket varchar [note: 'NULL voi URL ngoai hoac duong dan legacy']
  storage_path varchar [note: 'NULL voi URL ngoai hoac duong dan legacy']
  url varchar [not null]
  mime_type varchar
  alt_text varchar
  kich_thuoc_bytes int [check: `kich_thuoc_bytes >= 0`]
  chieu_rong int [check: `chieu_rong > 0`]
  chieu_cao int [check: `chieu_cao > 0`]
  ngay_tao timestamptz [not null, default: `now()`]

  indexes {
    (ma_sp, thu_tu) [unique]
    (ma_sp, url) [unique]
    (storage_bucket, storage_path)
  }

  checks {
    `(storage_bucket IS NULL) = (storage_path IS NULL)`
    `(ma_sp IS NULL AND thu_tu IS NULL AND la_anh_chinh = false) OR (ma_sp IS NOT NULL AND thu_tu IS NOT NULL)`
  }
}

Table TON_KHO {
  ma_kho int [not null]
  sku varchar [not null]
  so_luong_ton int [not null, default: 0, check: `so_luong_ton >= 0`]
  cap_nhat_luc datetime

  indexes {
    (ma_kho, sku) [pk]
  }
}

// ======================================
// 4. NHA CUNG CAP - NHAP HANG
// ======================================

Table NHA_CUNG_CAP {
  ma_ncc int [pk, increment]
  ten_ncc varchar [not null]
  sdt varchar
  email varchar
  dia_chi varchar
  trang_thai int [not null, default: 1]
}

Table PHIEU_NHAP {
  ma_phieu_nhap int [pk, increment]
  ma_phieu_code varchar [not null, unique]
  ma_ncc int [not null]
  ma_kho int [not null]
  ngay_tao datetime [not null]
  ngay_nhap datetime
  trang_thai varchar [not null, default: 'NHAP', note: 'NHAP, DA_NHAP, HUY']
  nguoi_tao varchar [not null]
  nguoi_cap_nhat varchar
  nguoi_xac_nhan varchar
  ghi_chu text
  dinh_gia_da_ap_dung boolean [not null, default: false]
}

Table CT_PHIEU_NHAP {
  ma_phieu_nhap int [not null]
  sku varchar [not null]
  so_luong_nhap int [not null, check: `so_luong_nhap > 0`]
  gia_nhap decimal(18,2) [not null, check: `gia_nhap >= 0`]
  ty_le_loi_nhuan decimal(12,4)
  thue_snapshot json [note: 'Chi luu ma, ten, ty le thue; khong luu so tien']

  indexes {
    (ma_phieu_nhap, sku) [pk]
  }
}

// ======================================
// 5. CHUYEN KHO
// ======================================

Table PHIEU_CHUYEN_KHO {
  ma_phieu_chuyen int [pk, increment]
  ma_kho_xuat int [not null]
  ma_kho_nhan int [not null]
  ngay_tao datetime [not null]
  ngay_xuat datetime
  ngay_nhan datetime
  trang_thai varchar [not null, default: 'NHAP', note: 'NHAP, DANG_CHUYEN, DA_NHAN, HUY']
  nguoi_tao varchar [not null]
  nguoi_xuat varchar
  nguoi_nhan varchar
  ghi_chu text

  checks {
    `ma_kho_xuat <> ma_kho_nhan`
  }
}

Table CT_CHUYEN_KHO {
  ma_phieu_chuyen int [not null]
  sku varchar [not null]
  so_luong int [not null, check: `so_luong > 0`]

  indexes {
    (ma_phieu_chuyen, sku) [pk]
  }
}

// ======================================
// 6. DON HANG
// ======================================

Table DON_HANG {
  ma_donhang varchar [pk]
  ma_kh varchar [note: 'NULL neu khach vang lai']

  ma_nhan_vien varchar [note: 'ADMIN xu ly don; NULL khi chua phan cong hoac xu ly tu dong']

  kenh_ban varchar [not null, note: 'TAI_QUAY, ONLINE']
  phuong_thuc_nhan varchar [note: 'GIAO_HANG, TAI_CUA_HANG; NULL cho don cu/chua ghi nhan. Khong phai kho xuat.']

  trang_thai varchar [not null, default: 'MOI', note: 'MOI, XAC_NHAN, DANG_CHUAN_BI, DA_XUAT_KHO, HOAN_THANH, HUY']

  thoi_gian_dat datetime [not null]
  thoi_gian_xuat_kho datetime
  thoi_gian_hoan_thanh datetime

  ten_nguoi_nhan varchar
  sdt_nguoi_nhan varchar
  email_nguoi_mua varchar [note: 'Email bat buoc khi tao don tai quay moi; NULL voi don lich su/chua ghi nhan']
  dia_chi_chi_tiet varchar
  tinh_thanh varchar
  xa_phuong varchar
  ghi_chu text
}

Table CT_DON_HANG {
  ma_ct_donhang int [pk, increment]
  ma_donhang varchar [not null]
  sku varchar [not null]
  ma_kho_xuat int [not null]

  ten_sp_luc_ban varchar [not null]
  don_vi_luc_ban varchar [not null]

  so_luong int [not null, check: `so_luong > 0`]
  don_gia decimal(18,2) [not null, note: 'Gia 1 san pham truoc thue']

  giam_gia decimal(18,2) [not null, default: 0, note: 'Giam gia ca dong, chua gom voucher']

  giam_gia_voucher decimal(18,2) [not null, default: 0, note: 'Phan tien voucher phan bo cho dong nay']

  thue_suat decimal(5,2) [not null, note: 'Ty le % tai thoi diem ban']
  tien_thue decimal(18,2) [not null, note: 'Tien thue ca dong sau lam tron']

  thanh_tien decimal(18,2) [not null, note: 'so_luong * don_gia - giam_gia - giam_gia_voucher + tien_thue']

  indexes {
    ma_donhang
    sku
  }

  checks {
    `don_gia >= 0 AND giam_gia >= 0 AND giam_gia_voucher >= 0 AND giam_gia + giam_gia_voucher <= so_luong * don_gia`
    `thue_suat >= 0 AND thue_suat <= 100 AND tien_thue >= 0`
    `thanh_tien = so_luong * don_gia - giam_gia - giam_gia_voucher + tien_thue`
  }
}

// ======================================
// 7. HOA DON - THANH TOAN
// ======================================

Table HOA_DON {
  han_thanh_toan timestamptz [note: 'KAN-61: hoa don ONLINE moi co han 24 gio; hoa don cu NULL']
  huy_qua_han_luc timestamptz [note: 'Thoi diem he thong huy don vi qua han; khong gan cho admin bat ky']
  ma_hoadon varchar [pk]
  ma_donhang varchar [not null, unique]
  thoi_gian_lap datetime [not null]

  ten_nguoi_mua varchar
  email_nguoi_mua varchar [note: 'Email khach hang trong hoa don lap thu cong']
  ma_so_thue varchar
  dia_chi_nguoi_mua varchar

  tong_tien_giam decimal(18,2) [not null, default: 0, note: 'Tong giam gia dong va voucher cua hoa don']
  tong_tien_truoc_thue decimal(18,2) [not null, note: 'Tong tien hang sau giam gia, truoc thue']
  tong_tien_thue decimal(18,2) [not null]
  tong_tien_sau_thue decimal(18,2) [not null]

  nguoi_lap varchar [note: 'Nhan vien lap thu cong; NULL khi he thong tu lap']
  nguon_lap varchar [not null, default: 'QUAN_TRI', note: 'QUAN_TRI, TU_DONG']
  ma_tk_lap varchar [note: 'Tai khoan khoi tao hoa don tu dong']

  checks {
    `tong_tien_giam >= 0`
    `tong_tien_truoc_thue >= 0 AND tong_tien_thue >= 0 AND tong_tien_sau_thue >= 0`
    `tong_tien_sau_thue = tong_tien_truoc_thue + tong_tien_thue`
    `(nguon_lap = 'QUAN_TRI' AND nguoi_lap IS NOT NULL) OR (nguon_lap = 'TU_DONG' AND nguoi_lap IS NULL)`
  }
}

Table THANH_TOAN {
  ma_thanh_toan int [pk, increment]
  ma_donhang varchar [not null]
  so_tien decimal(18,2) [not null, check: `so_tien > 0`]

  loai_giao_dich varchar [not null, default: 'THU', note: 'THU, HOAN_TIEN']

  phuong_thuc varchar [not null, note: 'TIEN_MAT, CHUYEN_KHOAN, THE, VI_DIEN_TU']

  trang_thai varchar [not null, note: 'CHO_XU_LY, THANH_CONG, THAT_BAI']

  ma_giao_dich varchar [unique, note: 'Ma doi soat duy nhat; NULL neu tien mat']
  thoi_gian datetime [not null]
  la_bypass boolean [not null, default: false, note: 'Ghi vao he thong khong qua cong thanh toan']
  ma_tk_ghi_nhan varchar [note: 'Tai khoan yeu cau ghi nhan thanh toan bypass']

  checks {
    `NOT la_bypass OR ma_tk_ghi_nhan IS NOT NULL`
  }
}

// ======================================
// 8. CHUONG TRINH KHUYEN MAI - VOUCHER
// ======================================

// Mot chuong trinh co nhieu voucher.
// Voucher ke thua thoi gian cua chuong trinh.
// Ap dung toan bo san pham.
// Moi don hang toi da 1 voucher.

Table CHUONG_TRINH_KHUYEN_MAI {
  ma_ctkm int [pk, increment]
  ten_chuong_trinh varchar [not null]
  mo_ta text
  ma_media_banner uuid [note: 'Mot banner tuy chon, lien ket MEDIA; NULL neu chua co banner']

  ngay_bat_dau datetime [not null]
  ngay_ket_thuc datetime [not null]

  trang_thai varchar [not null, default: 'NHAP', note: 'NHAP, HOAT_DONG, TAM_DUNG, KET_THUC']

  nguoi_tao varchar [not null]
  ngay_tao datetime [not null]

  checks {
    `ngay_ket_thuc > ngay_bat_dau`
    `trang_thai IN ('NHAP', 'HOAT_DONG', 'TAM_DUNG', 'KET_THUC')`
  }
}

Table VOUCHER {
  ma_voucher int [pk, increment]
  ma_ctkm int [not null]

  ma_code varchar [not null, unique, note: 'Chuan hoa viet hoa, bo khoang trang truoc khi luu/tra cuu']

  loai_giam varchar [not null, note: 'PHAN_TRAM, SO_TIEN']

  gia_tri_giam decimal(18,2) [not null, note: '10 = 10% neu PHAN_TRAM; 100000 = so tien neu SO_TIEN']

  giam_toi_da decimal(18,2) [note: 'Tran giam cho PHAN_TRAM; NULL neu khong gioi han']

  gia_tri_don_toi_thieu decimal(18,2) [not null, default: 0, note: 'Tong tien sau giam gia dong, truoc voucher va thue']

  gioi_han_tong_luot int [note: 'NULL neu khong gioi han']
  gioi_han_moi_khach int [not null, default: 1]

  trang_thai varchar [not null, default: 'HOAT_DONG', note: 'HOAT_DONG, TAM_DUNG']
  ngay_tao datetime [not null]

  checks {
    `loai_giam IN ('PHAN_TRAM', 'SO_TIEN')`
    `gia_tri_giam > 0 AND (loai_giam <> 'PHAN_TRAM' OR gia_tri_giam <= 100)`
    `giam_toi_da IS NULL OR (loai_giam = 'PHAN_TRAM' AND giam_toi_da > 0)`
    `gia_tri_don_toi_thieu >= 0`
    `gioi_han_tong_luot IS NULL OR gioi_han_tong_luot > 0`
    `gioi_han_moi_khach > 0`
    `trang_thai IN ('HOAT_DONG', 'TAM_DUNG')`
  }
}

Table SU_DUNG_VOUCHER {
  ma_su_dung int [pk, increment]
  ma_voucher int [not null]
  ma_donhang varchar [not null, unique]

  so_tien_giam decimal(18,2) [not null, check: `so_tien_giam > 0`, note: 'Tien giam thuc te da chot cho don, khong tinh lai tu voucher']

  thoi_gian_ap_dung datetime [not null]

  trang_thai varchar [not null, default: 'DA_AP_DUNG', note: 'DA_AP_DUNG, DA_HUY']

  thoi_gian_huy datetime

  checks {
    `(trang_thai = 'DA_AP_DUNG' AND thoi_gian_huy IS NULL) OR (trang_thai = 'DA_HUY' AND thoi_gian_huy IS NOT NULL)`
  }
}

// ======================================
// 9. QUAN HE
// ======================================

// Kho - Nhan vien

Ref: NHAN_VIEN.ma_kho > KHO.ma_kho

// Tai khoan - Khach hang - Nhan vien

Ref: KHACH_HANG.ma_kh - TAI_KHOAN.ma_kh
Ref: NHAN_VIEN.ma_nhan_vien - TAI_KHOAN.ma_nhan_vien
Ref: TAI_KHOAN.ma_media_anh_dai_dien > MEDIA.ma_media
Ref: TAI_KHOAN.luu_tru_boi > TAI_KHOAN.ma_tk

// San pham - Loai san pham - Ton kho

Ref: SAN_PHAM.ma_loai_sp > LOAI_SP.ma_loai_sp
Ref: LOAI_SP_CON.ma_loai_sp > LOAI_SP.ma_loai_sp
Ref: SAN_PHAM.(ma_loai_sp, ma_loai_sp_con) > LOAI_SP_CON.(ma_loai_sp, ma_loai_sp_con)
Ref: MEDIA.ma_sp > SAN_PHAM.ma_sp
Ref: CHUONG_TRINH_KHUYEN_MAI.ma_media_banner > MEDIA.ma_media
Ref: TON_KHO.ma_kho > KHO.ma_kho
Ref: TON_KHO.sku > SAN_PHAM.sku

// Nhap hang

Ref: PHIEU_NHAP.ma_ncc > NHA_CUNG_CAP.ma_ncc
Ref: PHIEU_NHAP.ma_kho > KHO.ma_kho
Ref: PHIEU_NHAP.nguoi_tao > NHAN_VIEN.ma_nhan_vien
Ref: PHIEU_NHAP.nguoi_cap_nhat > NHAN_VIEN.ma_nhan_vien
Ref: PHIEU_NHAP.nguoi_xac_nhan > NHAN_VIEN.ma_nhan_vien

Ref: CT_PHIEU_NHAP.ma_phieu_nhap > PHIEU_NHAP.ma_phieu_nhap
Ref: CT_PHIEU_NHAP.sku > SAN_PHAM.sku

// Chuyen kho

Ref: PHIEU_CHUYEN_KHO.ma_kho_xuat > KHO.ma_kho
Ref: PHIEU_CHUYEN_KHO.ma_kho_nhan > KHO.ma_kho
Ref: PHIEU_CHUYEN_KHO.nguoi_tao > NHAN_VIEN.ma_nhan_vien
Ref: PHIEU_CHUYEN_KHO.nguoi_xuat > NHAN_VIEN.ma_nhan_vien
Ref: PHIEU_CHUYEN_KHO.nguoi_nhan > NHAN_VIEN.ma_nhan_vien

Ref: CT_CHUYEN_KHO.ma_phieu_chuyen > PHIEU_CHUYEN_KHO.ma_phieu_chuyen
Ref: CT_CHUYEN_KHO.sku > SAN_PHAM.sku

// Don hang

Ref: DON_HANG.ma_kh > KHACH_HANG.ma_kh
Ref: DON_HANG.ma_nhan_vien > NHAN_VIEN.ma_nhan_vien

Ref: CT_DON_HANG.ma_donhang > DON_HANG.ma_donhang
Ref: CT_DON_HANG.sku > SAN_PHAM.sku
Ref: CT_DON_HANG.ma_kho_xuat > KHO.ma_kho

// Hoa don - Thanh toan

Ref: DON_HANG.ma_donhang - HOA_DON.ma_donhang
Ref: HOA_DON.nguoi_lap > NHAN_VIEN.ma_nhan_vien
Ref: HOA_DON.ma_tk_lap > TAI_KHOAN.ma_tk
Ref: THANH_TOAN.ma_tk_ghi_nhan > TAI_KHOAN.ma_tk
Ref: THANH_TOAN.ma_donhang > DON_HANG.ma_donhang

// Chuong trinh khuyen mai - Voucher

Ref: CHUONG_TRINH_KHUYEN_MAI.nguoi_tao > NHAN_VIEN.ma_nhan_vien
Ref: VOUCHER.ma_ctkm > CHUONG_TRINH_KHUYEN_MAI.ma_ctkm
Ref: SU_DUNG_VOUCHER.ma_voucher > VOUCHER.ma_voucher
Ref: DON_HANG.ma_donhang - SU_DUNG_VOUCHER.ma_donhang

// CRM: khuyen nghi 05/11/2026. Tuoi tinh tu ngay sinh; khong luu tuoi co dinh.
Table KHAO_SAT {
  khach_them text[] [not null, note: 'Khach them thu cong vao nguoi nhan cua ban nhap']
  khach_loai text[] [not null, note: 'Khach loai khoi danh sach; khong xoa ho so khach']
  ma_khao_sat uuid [pk]
  tieu_de varchar [not null]
  mo_ta text [not null]
  trang_thai varchar [not null, note: 'NHAP / DANG_MO / DONG']
  loai_doi_tuong varchar [not null, note: 'TAT_CA / DO_TUOI / CHUA_NGAY_SINH']
  tuoi_tu int
  tuoi_den int
  han_tra_loi timestamptz [not null]
  ngay_chot_doi_tuong timestamptz
  nguoi_tao varchar [not null]
  ngay_tao timestamptz [not null]
  cap_nhat_luc timestamptz [not null]
  phien_ban uuid [not null]
  hash_tao text [not null, note: 'Chong tao trung request_id']
  phat_hanh_tu_phien_ban uuid
  dong_tu_phien_ban uuid
}
Table CAU_HOI_KHAO_SAT {
  ma_cau_hoi uuid [pk]
  ma_khao_sat uuid [not null]
  noi_dung varchar [not null]
  loai_cau_hoi varchar [not null, note: 'MOT_LUA_CHON / DIEM_1_5 / VAN_BAN']
  nhom_noi_dung varchar [not null, note: 'CHUNG / SO_THICH / HAI_LONG']
  bat_buoc boolean [not null]
  thu_tu int [not null]
  indexes {
    (ma_cau_hoi, ma_khao_sat) [unique]
    (ma_khao_sat, thu_tu) [unique]
  }
}
Table LUA_CHON_KHAO_SAT {
  ma_lua_chon uuid [pk]
  ma_cau_hoi uuid [not null]
  noi_dung varchar [not null]
  cho_phep_nhap_khac boolean [not null, note: 'Toi da 1 lua chon Khac/cau hoi']
  thu_tu int [not null]
  indexes {
    (ma_lua_chon, ma_cau_hoi) [unique]
    (ma_cau_hoi, thu_tu) [unique]
  }
}
Table GUI_KHAO_SAT {
  ma_gui uuid [pk]
  ma_khao_sat uuid [not null]
  ma_kh varchar [not null]
  ngay_gui timestamptz [not null]
  hoan_thanh_luc timestamptz
  khoa_gui_bai uuid
  hash_gui_bai text
  indexes {
    (ma_khao_sat, ma_kh) [unique]
    (ma_gui, ma_khao_sat) [unique]
  }
}
Table TRA_LOI_KHAO_SAT {
  ma_tra_loi uuid [pk]
  ma_gui uuid [not null]
  ma_khao_sat uuid [not null]
  ma_cau_hoi uuid [not null]
  ma_lua_chon uuid
  diem int [note: '1-5; NULL neu khong phai cau diem']
  noi_dung text [note: 'Van ban hoac phan nhap Khac, toi da 4000 ky tu']
  indexes {
    (ma_gui, ma_cau_hoi) [unique]
    (ma_gui, ma_khao_sat)
  }
}
Table DANH_GIA_SAN_PHAM {
  ma_danh_gia uuid [pk]
  ma_kh varchar [not null]
  ma_sp varchar [not null]
  ma_donhang varchar [not null]
  so_sao int [not null, note: '1-5']
  noi_dung text [not null]
  trang_thai varchar [not null, note: 'HIEN_THI / AN; hiển thị ngay sau khi gửi']
  ngay_tao timestamptz [not null]
  cap_nhat_luc timestamptz [not null]
  phien_ban uuid [not null]
  nguoi_duyet varchar
  ngay_duyet timestamptz
  duyet_tu_phien_ban uuid
  indexes {
    (ma_kh, ma_sp) [unique]
  }
}
Ref: KHAO_SAT.nguoi_tao > TAI_KHOAN.ma_tk
Ref: CAU_HOI_KHAO_SAT.ma_khao_sat > KHAO_SAT.ma_khao_sat
Ref: LUA_CHON_KHAO_SAT.ma_cau_hoi > CAU_HOI_KHAO_SAT.ma_cau_hoi
Ref: GUI_KHAO_SAT.ma_khao_sat > KHAO_SAT.ma_khao_sat
Ref: GUI_KHAO_SAT.ma_kh > KHACH_HANG.ma_kh
Ref: TRA_LOI_KHAO_SAT.(ma_gui, ma_khao_sat) > GUI_KHAO_SAT.(ma_gui, ma_khao_sat)
Ref: TRA_LOI_KHAO_SAT.(ma_cau_hoi, ma_khao_sat) > CAU_HOI_KHAO_SAT.(ma_cau_hoi, ma_khao_sat)
Ref: TRA_LOI_KHAO_SAT.(ma_lua_chon, ma_cau_hoi) > LUA_CHON_KHAO_SAT.(ma_lua_chon, ma_cau_hoi)
Ref: DANH_GIA_SAN_PHAM.ma_kh > KHACH_HANG.ma_kh
Ref: DANH_GIA_SAN_PHAM.ma_sp > SAN_PHAM.ma_sp
Ref: DANH_GIA_SAN_PHAM.ma_donhang > DON_HANG.ma_donhang
Ref: DANH_GIA_SAN_PHAM.nguoi_duyet > TAI_KHOAN.ma_tk
