FRONTEND_URL=http://localhost:3000
# Optional multiple browser origins; overrides FRONTEND_URL. No wildcard.
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3001,https://your-shop.onrender.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Optional SQL connection for installing the prepared customer RPCs locally.
# Never put this in Frontend. Copy the actual URL from Supabase Dashboard > Connect.
# SUPABASE_DB_URL=postgresql://copy-connection-string-from-supabase-connect
# Customer orders: rules confirmed with the user; VAT is applied at invoicing.
ORDER_STOCK_POLICY=reserve_on_order
ORDER_PRICE_TAX_MODE=exclusive
ORDER_TAX_RATE=10
ORDER_TAX_APPLICATION=invoice
# Timestamp columns of promotion start/end are interpreted in this timezone.
CHECKOUT_PROMOTION_TIMEZONE=Asia/Ho_Chi_Minh
